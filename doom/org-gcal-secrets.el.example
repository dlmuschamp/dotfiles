;;; org-gcal-secrets.el --- local Google OAuth + calendar IDs -*- lexical-binding: t; -*-
;; Copy to org-gcal-secrets.el (gitignored) and fill in real values.
;; Create OAuth credentials in Google Cloud Console → APIs → Credentials.

(setq org-gcal-client-id "YOUR_CLIENT_ID.apps.googleusercontent.com"
      org-gcal-client-secret "YOUR_CLIENT_SECRET")

(defconst luciano/org-gcal-personal-id "you@gmail.com"
  "Google Calendar ID for Personal.")
(defconst luciano/org-gcal-school-id "YOUR_SCHOOL_CALENDAR_ID@group.calendar.google.com"
  "Google Calendar ID for School.")
(defconst luciano/org-gcal-arbor-id "YOUR_ARBOR_CALENDAR_ID@group.calendar.google.com"
  "Google Calendar ID for Arbor Live.")
(defconst luciano/org-gcal-canvas-id "YOUR_CANVAS_IMPORT_ID@import.calendar.google.com"
  "Google Calendar ID for Canvas ICS import (pull-only).")

(provide 'org-gcal-secrets)
