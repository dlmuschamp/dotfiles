{
  "version": 1,
  "disabledPlugins": [
    "omarchy.lock",
    "omarchy.idle",
    "omarchy.emojis",
    "omarchy.nightlight",
    "omarchy.agents"
  ],
  "bar": {
    "position": "bottom",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators",
          "items": [
            "Dnd",
            "Reminder",
            "ScreenRecording"
          ]
        },
        {
          "id": "omarchy.clock",
          "format": "dddd h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "hh\n—\nmm"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "cpu",
          "type": "qml"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "wacom-pen",
          "type": "qml",
          "source": "~/.config/omarchy/bar/modules/wacom-pen.qml"
        }
      ]
    }
  },
  "plugins": []
}
