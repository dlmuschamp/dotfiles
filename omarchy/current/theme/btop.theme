# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#010419"

# Main text color
theme[main_fg]="#E5DBBA"

# Title color for boxes
theme[title]="#E5DBBA"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#dc5582"

# Background color of selected item in processes box. #E5DBBA maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #1a1d30 gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#1a1d30"

# Foreground color of selected item in processes box. Use #E5DBBA so
# the row text stays readable on the lighter_bg highlight; the previous
# #dc5582 produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#E5DBBA"

# Color of inactive/disabled text
theme[inactive_fg]="#67696f"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #e9e0c4 caps at #ffffff when the foreground is already pure white, so we
# just bind it to #E5DBBA directly.
theme[graph_text]="#E5DBBA"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #E5DBBA collapsed to the main fg.
theme[meter_bg]="#1a1d30"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #008e8e for a distinct accent instead of #e9e0c4 which capped to white.
theme[proc_misc]="#008e8e"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#e762d2"
theme[mem_box]="#61bc5c"
theme[net_box]="#ff8b73"
theme[proc_box]="#dc5582"

# Box divider line and small boxes line color
theme[div_line]="#67696f"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#61bc5c"
theme[temp_mid]="#e7bc3f"
theme[temp_end]="#ff8b73"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#008e8e"
theme[cpu_mid]="#5582dc"
theme[cpu_end]="#e762d2"

# Mem/Disk free meter
theme[free_start]="#e762d2"
theme[free_mid]="#5582dc"
theme[free_end]="#008e8e"

# Mem/Disk cached meter
theme[cached_start]="#5582dc"
theme[cached_mid]="#008e8e"
theme[cached_end]="#e762d2"

# Mem/Disk available meter
theme[available_start]="#e7bc3f"
theme[available_mid]="#ff8b73"
theme[available_end]="#ff8b73"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#61bc5c"
theme[used_mid]="#008e8e"
theme[used_end]="#5582dc"

# Download graph colors
theme[download_start]="#e7bc3f"
theme[download_mid]="#ff8b73"
theme[download_end]="#ff8b73"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#61bc5c"
theme[upload_mid]="#008e8e"
theme[upload_end]="#5582dc"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#008e8e"
theme[process_mid]="#5582dc"
theme[process_end]="#e762d2"
