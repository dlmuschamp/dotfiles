#!/bin/bash

set -euo pipefail

repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
bin_home="$HOME/.local/bin"
runtime_dir="$data_home/omarchy"
runtime_commit=$(<"$repo_dir/omarchy/runtime.commit")
timestamp=$(date +%Y%m%d%H%M%S)

mkdir -p "$config_home" "$data_home" "$bin_home"

backup_path() {
  local path=$1
  local backup="${path}.pre-dotfiles.${timestamp}"
  mv -- "$path" "$backup"
  printf 'Backed up %s -> %s\n' "$path" "$backup"
}

link_path() {
  local source=$1
  local target=$2

  mkdir -p "$(dirname -- "$target")"

  if [[ -L $target ]]; then
    if [[ $(readlink -f -- "$target") == "$(readlink -f -- "$source")" ]]; then
      return
    fi
    rm -- "$target"
  elif [[ -e $target ]]; then
    backup_path "$target"
  fi

  ln -s -- "$source" "$target"
  printf 'Linked %s -> %s\n' "$target" "$source"
}

install_runtime() {
  if [[ ! -d $runtime_dir/.git ]]; then
    if [[ -e $runtime_dir || -L $runtime_dir ]]; then
      backup_path "$runtime_dir"
    fi
    git clone https://github.com/basecamp/omarchy.git "$runtime_dir"
  fi

  if ! git -C "$runtime_dir" diff --quiet ||
     ! git -C "$runtime_dir" diff --cached --quiet; then
    printf 'Refusing to replace modified Omarchy runtime: %s\n' "$runtime_dir" >&2
    exit 1
  fi

  git -C "$runtime_dir" fetch origin "$runtime_commit"
  git -C "$runtime_dir" checkout --detach "$runtime_commit"
}

install_runtime

# Doom Emacs framework lives outside the repo (its own git checkout). User
# config is tracked under doom/ and linked to XDG_CONFIG_HOME/doom.
install_doom_emacs() {
  local emacs_dir="$config_home/emacs"
  if [[ ! -d $emacs_dir/.git ]]; then
    if [[ -e $emacs_dir || -L $emacs_dir ]]; then
      backup_path "$emacs_dir"
    fi
    git clone --depth 1 https://github.com/doomemacs/doomemacs "$emacs_dir"
  fi
  link_path "$emacs_dir/bin/doom" "$bin_home/doom"
}

install_doom_emacs

# Ubuntu Yaru icons (what Omarchy themes reference via icons.theme). Cloned from
# upstream and installed under XDG_DATA_HOME/icons so Nautilus and GTK apps get
# their folder/mime icons without the Omarchy pacman package.
install_yaru_icons() {
  local yaru_src="$HOME/.local/src/ubuntu-yaru"
  local icons_dest="$data_home/icons"
  local theme accent

  mkdir -p "$(dirname -- "$yaru_src")" "$icons_dest"

  if [[ ! -d $yaru_src/.git ]]; then
    if [[ -e $yaru_src || -L $yaru_src ]]; then
      backup_path "$yaru_src"
    fi
    git clone --depth 1 https://github.com/ubuntu/yaru.git "$yaru_src"
  fi

  # Skip rebuild when the active Omarchy accent is already installed.
  if [[ -f $icons_dest/Yaru/index.theme && -f $icons_dest/Yaru-magenta/index.theme ]]; then
    printf 'Yaru icons already installed under %s\n' "$icons_dest"
    return
  fi

  (
    cd "$yaru_src/icons"
    bash src/symlinks/generate-symlinks.sh --all --variant default >/dev/null
    bash src/symlinks/generate-symlinks.sh --all --variant dark >/dev/null || true
    python3 src/generate-index-theme.py Yaru \
      --source-dir "$yaru_src/icons/Yaru" \
      --output-dir "$yaru_src/icons/Yaru" \
      --output-name index.theme \
      --comment 'Ubuntu Yaru icon theme' >/dev/null
    python3 src/generate-index-theme.py Yaru-dark \
      --source-dir "$yaru_src/icons/Yaru-dark" \
      --output-dir "$yaru_src/icons/Yaru-dark" \
      --output-name index.theme \
      --inherits Yaru --inherits hicolor \
      --comment 'Ubuntu Yaru dark icon theme' >/dev/null
    for accent in magenta blue olive purple red sage yellow prussiangreen wartybrown mate bark; do
      [[ -d $yaru_src/icons/Yaru-$accent ]] || continue
      bash src/symlinks/generate-symlinks.sh --all --variant "$accent" >/dev/null || true
      python3 src/generate-index-theme.py "Yaru-$accent" \
        --source-dir "$yaru_src/icons/Yaru-$accent" \
        --output-dir "$yaru_src/icons/Yaru-$accent" \
        --output-name index.theme \
        --inherits Yaru --inherits hicolor \
        --comment "Ubuntu Yaru $accent icon theme" >/dev/null
    done
  )

  for theme in Yaru Yaru-dark Yaru-magenta Yaru-blue Yaru-olive Yaru-purple \
               Yaru-red Yaru-sage Yaru-yellow Yaru-prussiangreen \
               Yaru-wartybrown Yaru-mate Yaru-bark; do
    [[ -d $yaru_src/icons/$theme ]] || continue
    rm -rf -- "$icons_dest/$theme"
    cp -a -- "$yaru_src/icons/$theme" "$icons_dest/$theme"
    gtk-update-icon-cache -f "$icons_dest/$theme" >/dev/null 2>&1 || true
  done

  printf 'Installed Yaru icons from %s -> %s\n' "$yaru_src" "$icons_dest"
}

install_yaru_icons

for config in alacritty doom fontconfig gtk-3.0 gtk-4.0 hypr nvim omarchy sioyek tmux uwsm; do
  link_path "$repo_dir/$config" "$config_home/$config"
done

link_path \
  "$repo_dir/xdg-terminal-exec/hyprland-xdg-terminals.list" \
  "$config_home/hyprland-xdg-terminals.list"
link_path "$repo_dir/nvim/.neoconf.json" "$HOME/.neoconf.json"

for command in "$repo_dir"/bin/* "$repo_dir"/automations/bin/*; do
  [[ -f $command ]] || continue
  chmod +x "$command"
  link_path "$command" "$bin_home/$(basename -- "$command")"
done

chmod +x "$repo_dir/omarchy/bar/scripts/wacom-pen-battery"

# omarchy.ttf carries the private-use menu glyph; the STIX families back the
# Typst documents.
while IFS= read -r font; do
  link_path "$font" "$data_home/fonts/$(basename -- "$font")"
done < <(find "$repo_dir/fonts" -type f -name '*.ttf' | sort)

fc-cache -f "$data_home/fonts" >/dev/null

printf '\nDotfiles deployed. Log out and back in to load the UWSM environment.\n'
