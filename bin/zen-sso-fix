#!/bin/bash
#
# Recovers Outlook Web when it signs you out immediately after a successful
# Stanford login ("You're signed out of your account. It's a good idea to close
# all browser windows.").
#
# What goes wrong: OWA boots on outlook.cloud.microsoft, reads the account
# identity and MSAL state it left in localStorage/IndexedDB from a previous
# session, finds it inconsistent with the token it just obtained, and calls
# logoutRedirect() a second later. Its service worker keeps serving the same
# poisoned boot. Cookies and privacy settings are not involved, which is why a
# private window or a fresh profile works and clearing cookies alone does not.
#
# So the fix is to wipe every trace of the Microsoft origins' site data and let
# OWA boot from nothing. Stanford's own SSO state is deliberately left alone so
# this does not cost you a Duo prompt.
#
# Zen must be fully closed, since it holds write locks on these databases.
#
# Usage: zen-sso-fix

set -euo pipefail

# Suffix-matched against cookie hosts and storage origins. Stanford is absent on
# purpose: clearing login.stanford.edu would drop the Shibboleth session and
# force a fresh Duo push on the next sign-in.
domains=(
  microsoftonline.com
  cloud.microsoft
  office.com
  office365.com
  outlook.com
  live.com
  windows.net
)

# Cookie exceptions, kept from the previous version of this script. They exempt
# the SSO domains from Total Cookie Protection partitioning. Not the cause of
# the logout loop, but they cost nothing and remove a variable.
allow_origins=(
  https://login.microsoftonline.com
  https://login.live.com
  https://login.windows.net
  https://outlook.office.com
  https://outlook.office365.com
  https://outlook.cloud.microsoft
  https://cloud.microsoft
  https://office.com
  https://www.office.com
  https://login.stanford.edu
  https://idp.stanford.edu
)

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
cache_home="${XDG_CACHE_HOME:-$HOME/.cache}"
zen_home="$config_home/zen"

if [[ ! -f $zen_home/profiles.ini ]]; then
  printf 'No Zen profiles.ini under %s. Launch Zen once first.\n' "$zen_home" >&2
  exit 1
fi

if pgrep -x zen-bin >/dev/null || pgrep -f '/zen/zen$' >/dev/null; then
  printf 'Zen is still running. Quit it completely, then re-run.\n' >&2
  exit 1
fi

# profiles.ini names the profile directory with a random prefix, so resolve it
# rather than hardcoding. An [InstallHASH] section's Default= wins over a
# [ProfileN] Default=1, matching Zen's own precedence.
profile_rel=$(python3 - "$zen_home/profiles.ini" <<'PY'
import configparser, sys
cp = configparser.ConfigParser()
cp.read(sys.argv[1])
install = next((cp[s]["Default"] for s in cp.sections()
                if s.startswith("Install") and cp[s].get("Default")), None)
if install:
    print(install)
    raise SystemExit
for s in cp.sections():
    if s.startswith("Profile") and cp[s].get("Default") == "1":
        print(cp[s]["Path"])
        raise SystemExit
for s in cp.sections():
    if s.startswith("Profile") and cp[s].get("Path"):
        print(cp[s]["Path"])
        raise SystemExit
raise SystemExit("no profile found in profiles.ini")
PY
)

profile="$zen_home/$profile_rel"
[[ -d $profile ]] || { printf 'Resolved profile %s does not exist.\n' "$profile" >&2; exit 1; }
printf 'Profile: %s\n\n' "$profile"

backup="$profile/.sso-fix-backup.$(date +%Y%m%d%H%M%S)"
mkdir -p "$backup"
for f in cookies.sqlite permissions.sqlite storage.sqlite serviceworker.txt; do
  [[ -f $profile/$f ]] && cp -- "$profile/$f" "$backup/$f"
done
printf 'Backed up databases to %s\n\n' "$backup"

# Build the SQL host predicate once: exact match plus any subdomain.
host_pred=""
for d in "${domains[@]}"; do
  host_pred+="${host_pred:+ OR }host = '$d' OR host LIKE '%.$d'"
done

# 1. Cookies. Also drops partitioned copies these sites left inside other sites,
#    since those carry the same stale identity.
part_pred=""
for d in "${domains[@]}"; do
  part_pred+="${part_pred:+ OR }originAttributes LIKE '%$d%'"
done
before=$(sqlite3 "$profile/cookies.sqlite" "SELECT count(*) FROM moz_cookies;")
sqlite3 "$profile/cookies.sqlite" "DELETE FROM moz_cookies WHERE ($host_pred) OR ($part_pred);"
after=$(sqlite3 "$profile/cookies.sqlite" "SELECT count(*) FROM moz_cookies;")
printf 'Cookies removed: %s\n' "$(( before - after ))"

# 2. localStorage, IndexedDB and Cache API. This is the part that actually
#    clears the poisoned OWA boot state.
removed=0
shopt -s nullglob
for d in "${domains[@]}"; do
  for dir in "$profile"/storage/default/*"$d"*; do
    [[ -d $dir ]] || continue
    rm -rf -- "$dir"
    printf '  cleared storage: %s\n' "$(basename "$dir")"
    removed=$(( removed + 1 ))
  done
done
shopt -u nullglob
printf 'Storage origins cleared: %s\n' "$removed"

# 3. Quota manager index, so it does not point at directories that are now gone.
origin_pred=""
for d in "${domains[@]}"; do
  origin_pred+="${origin_pred:+ OR }origin LIKE '%$d'"
done
sqlite3 "$profile/storage.sqlite" "DELETE FROM origin WHERE $origin_pred;" 2>/dev/null || true

# 4. Service worker registrations. The file is a positional flat format that is
#    not safe to edit line by line, so drop it whole; every site simply
#    re-registers its worker on the next visit.
if [[ -f $profile/serviceworker.txt ]]; then
  rm -f -- "$profile/serviceworker.txt"
  printf 'Service worker registrations reset\n'
fi

# 5. HTTP cache, which can still be holding the stale OWA service worker script.
cache_dir="$cache_home/zen/$profile_rel/cache2"
if [[ -d $cache_dir ]]; then
  rm -rf -- "$cache_dir"
  printf 'HTTP cache cleared\n'
fi

# 6. Cookie exceptions. permission=1 is ALLOW, expireType=0 never expires.
#    moz_perms has no unique constraint, so delete before insert to stay
#    idempotent across re-runs.
now_ms=$(( $(date +%s) * 1000 ))
for origin in "${allow_origins[@]}"; do
  sqlite3 "$profile/permissions.sqlite" \
    "DELETE FROM moz_perms WHERE origin='$origin' AND type='cookie';
     INSERT INTO moz_perms (origin, type, permission, expireType, expireTime, modificationTime)
     VALUES ('$origin', 'cookie', 1, 0, 0, $now_ms);"
done
printf 'Cookie exceptions applied: %s\n' "${#allow_origins[@]}"

cat <<'EOF'

Done. Now start Zen and go to https://outlook.office.com/mail/ directly,
rather than restoring an old Outlook tab, so OWA boots from a clean slate.
Tick "Stay signed in" when Microsoft offers it.

If the sign-out ever comes back, quit Zen and run this again.
EOF
