#!/bin/bash
#
# Recovers Outlook Web when it signs you out a second after a successful
# Stanford login ("You're signed out of your account. It's a good idea to close
# all browser windows.").
#
# Confirmed 2026-09-07: a brand-new Zen profile signs in and stays signed in
# across a second cold Outlook tab. The engine is fine; the normal profile's
# Outlook state is not. Failures correlate with landing on
# outlook.cloud.microsoft after Duo; working sessions stay on
# outlook.office.com. Private windows and fresh profiles work because they have
# none of that host's broken site data. Extensions are not involved (safe mode
# still fails).
#
# Default mode clears Outlook cookies (including partitioned copies) plus
# Outlook site data and the HTTP cache, and re-applies cookie / storage-access /
# ETP exceptions so Total Cookie Protection does not partition
# login.microsoftonline.com away from OWA. AAD cookies are kept.
#
# Important: keeping AAD alone is not enough. Stale Duo "remember device" and
# Stanford IdP cookies plus ESTSSSOTILES recreate a half-SSO path (Duo flash →
# immediate sign-out) in the normal profile while private windows work. --deep
# clears Microsoft + Duo + login.stanford.edu / idp.stanford.edu, then matches
# the working private-window path (full interactive SSO).
# Prefer --deep / zen-outlook --recover when the sign-out loop is active.
#
# Zen must be fully closed, since it holds a write lock on cookies.sqlite.
#
# Usage: zen-sso-fix [--deep]

set -euo pipefail

deep=0
case "${1:-}" in
  --deep) deep=1 ;;
  '') ;;
  *) printf 'Usage: %s [--deep]\n' "${0##*/}" >&2; exit 2 ;;
esac

# The hosts OWA itself serves from. Neither login.microsoftonline.com nor
# anything under stanford.edu appears here, so the SSO session is preserved.
outlook_hosts=(
  outlook.office.com
  outlook.office365.com
  outlook.cloud.microsoft
  sdf.outlook.cloud.microsoft
  outlook-sdf.office.com
  outlook-sdf.office365.com
)

# Storage directory suffixes under storage/default/. Scoped to OWA itself.
outlook_storage=(
  outlook.office.com
  outlook.office365.com
  outlook.cloud.microsoft
  sdf.outlook.cloud.microsoft
)

# --deep also clears IdP / Duo site data so "remembered device" cannot short-
# circuit into the broken MSAL path.
deep_storage=(
  login.stanford.edu
  idp.stanford.edu
  duosecurity.com
  api-531b0865.duosecurity.com
  login.microsoftonline.com
  login.microsoft.com
  office.com
  www.office.com
  cloud.microsoft
  m365.cloud.microsoft
)

# Origins that need durable cookie Allow + ETP off + storage-access grants.
allow_origins=(
  https://login.microsoftonline.com
  https://login.live.com
  https://login.windows.net
  https://outlook.office.com
  https://outlook.office365.com
  https://outlook.cloud.microsoft
  https://cloud.microsoft
  https://office.com
  https://www.office.com
  https://login.stanford.edu
  https://idp.stanford.edu
)

# First-party origins that must be able to read login.microsoftonline.com
# cookies from a hidden iframe under Total Cookie Protection.
storage_access_first_parties=(
  https://outlook.office.com
  https://outlook.office365.com
  https://outlook.cloud.microsoft
  https://cloud.microsoft
  https://office.com
  https://www.office.com
  https://m365.cloud.microsoft
)

# --deep only. Widened to every Microsoft origin PLUS Duo remember-device and
# Stanford IdP cookies. Keeping those used to leave a half-SSO path: brief Duo
# flash → ESTSAUTHPERSISTENT + SSOTILES → immediate "You're signed out" in the
# normal profile, while private (empty jar) worked. Full wipe costs one complete
# Stanford+Duo login and matches the working private-window path.
deep_domains=(
  microsoftonline.com
  cloud.microsoft
  office.com
  office365.com
  outlook.com
  live.com
  windows.net
  duosecurity.com
  login.stanford.edu
  idp.stanford.edu
)

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
cache_home="${XDG_CACHE_HOME:-$HOME/.cache}"
zen_home="$config_home/zen"

if [[ ! -f $zen_home/profiles.ini ]]; then
  printf 'No Zen profiles.ini under %s. Launch Zen once first.\n' "$zen_home" >&2
  exit 1
fi

if pgrep -x zen-bin >/dev/null; then
  printf 'Zen is still running. Quit it completely, then re-run.\n' >&2
  exit 1
fi

# profiles.ini names the profile directory with a random prefix, so resolve it
# rather than hardcoding. An [InstallHASH] section's Default= wins over a
# [ProfileN] Default=1, matching Zen's own precedence.
profile_rel=$(python3 - "$zen_home/profiles.ini" <<'PY'
import configparser, sys
cp = configparser.ConfigParser()
cp.read(sys.argv[1])
install = next((cp[s]["Default"] for s in cp.sections()
                if s.startswith("Install") and cp[s].get("Default")), None)
if install:
    print(install)
    raise SystemExit
for s in cp.sections():
    if s.startswith("Profile") and cp[s].get("Default") == "1":
        print(cp[s]["Path"])
        raise SystemExit
for s in cp.sections():
    if s.startswith("Profile") and cp[s].get("Path"):
        print(cp[s]["Path"])
        raise SystemExit
raise SystemExit("no profile found in profiles.ini")
PY
)

profile="$zen_home/$profile_rel"
[[ -d $profile ]] || { printf 'Resolved profile %s does not exist.\n' "$profile" >&2; exit 1; }
printf 'Profile: %s\n\n' "$profile"

backup="$profile/.sso-fix-backup.$(date +%Y%m%d%H%M%S)"
mkdir -p "$backup"
cp -- "$profile/cookies.sqlite" "$backup/cookies.sqlite"
if [[ -f $profile/permissions.sqlite ]]; then
  cp -- "$profile/permissions.sqlite" "$backup/permissions.sqlite"
fi
for f in storage.sqlite serviceworker.txt; do
  if [[ -f $profile/$f ]]; then cp -- "$profile/$f" "$backup/$f"; fi
done
printf 'Backed up to %s\n\n' "$backup"

before=$(sqlite3 "$profile/cookies.sqlite" "SELECT count(*) FROM moz_cookies;")

if (( deep )); then
  # Exact match plus any subdomain, and partitioned copies these sites left
  # inside other sites.
  pred=""
  for d in "${deep_domains[@]}"; do
    pred+="${pred:+ OR }host = '$d' OR host LIKE '%.$d' OR originAttributes LIKE '%$d%'"
  done
else
  # Exact Outlook hosts, dotted variants, and any cookie partitioned under an
  # Outlook / cloud.microsoft top-level site.
  pred=""
  for h in "${outlook_hosts[@]}"; do
    pred+="${pred:+ OR }host = '$h' OR host = '.$h' OR originAttributes LIKE '%$h%'"
  done
  pred+=" OR host LIKE '%safelinks.protection.outlook.com%'"
  pred+=" OR originAttributes LIKE '%cloud.microsoft%'"
fi

sqlite3 "$profile/cookies.sqlite" "DELETE FROM moz_cookies WHERE $pred;"
after=$(sqlite3 "$profile/cookies.sqlite" "SELECT count(*) FROM moz_cookies;")
printf 'Cookies removed: %s\n' "$(( before - after ))"

# Microsoft sets these during logoutRedirect(); while present (=1) they interrupt
# SSO on the next sign-in and recreate the "You're signed out" loop.
tiles=$(sqlite3 "$profile/cookies.sqlite" \
  "DELETE FROM moz_cookies WHERE name IN ('ESTSSSOTILES','AADSSOTILES','SSOCOOKIEPULLED');
   SELECT changes();")
printf 'SSO-interrupt cookies removed: %s (ESTSSSOTILES/AADSSOTILES/SSOCOOKIEPULLED)\n' "$tiles"

printf 'SSO cookies kept: %s AAD, %s Stanford, %s Duo\n' \
  "$(sqlite3 "$profile/cookies.sqlite" "SELECT count(*) FROM moz_cookies WHERE host LIKE '%microsoftonline.com';")" \
  "$(sqlite3 "$profile/cookies.sqlite" "SELECT count(*) FROM moz_cookies WHERE host LIKE '%stanford.edu';")" \
  "$(sqlite3 "$profile/cookies.sqlite" "SELECT count(*) FROM moz_cookies WHERE host LIKE '%duosecurity.com';")"

# permission=1 is ALLOW, permission=2 is DENY (for trackingprotection: ETP off).
# expireType=0 never expires. moz_perms has no unique constraint, so delete
# before insert to stay idempotent across re-runs.
now_ms=$(( $(date +%s) * 1000 ))
perms_db="$profile/permissions.sqlite"
[[ -f $perms_db ]] || sqlite3 "$perms_db" "CREATE TABLE moz_perms (id INTEGER PRIMARY KEY, origin TEXT, type TEXT, permission INTEGER, expireType INTEGER, expireTime INTEGER, modificationTime INTEGER);"

upsert_perm() {
  local origin=$1 type=$2 permission=$3
  sqlite3 "$perms_db" \
    "DELETE FROM moz_perms WHERE origin='$origin' AND type='$type';
     INSERT INTO moz_perms (origin, type, permission, expireType, expireTime, modificationTime)
     VALUES ('$origin', '$type', $permission, 0, 0, $now_ms);"
}

for origin in "${allow_origins[@]}"; do
  upsert_perm "$origin" cookie 1
  # DENY trackingprotection == turn Enhanced Tracking Protection off for site
  # (same as clicking the shield icon and disabling it).
  upsert_perm "$origin" trackingprotection 2
done
printf 'Cookie Allow + ETP-off applied: %s origins\n' "${#allow_origins[@]}"

for origin in "${storage_access_first_parties[@]}"; do
  upsert_perm "$origin" '3rdPartyStorage^https://login.microsoftonline.com' 1
  upsert_perm "$origin" storageAccessAPI 1
done
printf 'Storage-access grants applied: %s first parties → login.microsoftonline.com\n' \
  "${#storage_access_first_parties[@]}"

clear_storage_for() {
  local -n _domains=$1
  local removed=0
  shopt -s nullglob
  for d in "${_domains[@]}"; do
    for dir in "$profile"/storage/default/*"$d"*; do
      [[ -d $dir ]] || continue
      rm -rf -- "$dir"
      removed=$(( removed + 1 ))
    done
  done
  shopt -u nullglob
  printf 'Storage origins cleared: %s\n' "$removed"

  origin_pred=""
  for d in "${_domains[@]}"; do
    origin_pred+="${origin_pred:+ OR }origin LIKE '%$d%'"
  done
  if [[ -n $origin_pred ]]; then
    sqlite3 "$profile/storage.sqlite" "DELETE FROM origin WHERE $origin_pred;" 2>/dev/null || true
  fi
}

clear_storage_for outlook_storage

if [[ -f $profile/serviceworker.txt ]]; then
  rm -f -- "$profile/serviceworker.txt"
  printf 'Service worker registrations reset\n'
fi

# Cached redirects / SW responses can re-send a clean session to
# outlook.cloud.microsoft. Clear the profile HTTP cache on every recovery.
cache_dir="$cache_home/zen/$profile_rel/cache2"
if [[ -d $cache_dir ]]; then
  rm -rf -- "$cache_dir"
  printf 'HTTP cache cleared\n'
fi

if (( deep )); then
  clear_storage_for deep_storage

  # Session restore can replay tabs with one-time OAuth #code= fragments and
  # oauth2/logout / owa logoff.aspx URLs, which immediately burns the new login
  # (private windows work because they have no session restore). Clear active
  # session files; leave zen-sessions-backup/ archives alone.
  sess_backup="$profile/.sso-session-backup.$(date +%Y%m%d%H%M%S)"
  mkdir -p "$sess_backup"
  for f in sessionstore.jsonlz4 zen-sessions.jsonlz4 sessionCheckpoints.json; do
    if [[ -f $profile/$f ]]; then
      mv -- "$profile/$f" "$sess_backup/"
    fi
  done
  if [[ -d $profile/sessionstore-backups ]]; then
    find "$profile/sessionstore-backups" -maxdepth 1 -type f \( -name '*.jsonlz4' -o -name '*.baklz4' \) \
      -exec mv -t "$sess_backup/" {} +
  fi
  # Zen keeps a "clean/recovery" pair that can resurrect the bad session.
  if [[ -d $profile/zen-sessions-backup ]]; then
    for f in clean.jsonlz4 recovery.baklz4 recovery.jsonlz4; do
      if [[ -f $profile/zen-sessions-backup/$f ]]; then
        mv -- "$profile/zen-sessions-backup/$f" "$sess_backup/"
      fi
    done
  fi
  printf 'Session restore cleared (stale OAuth/logout tabs) → %s\n' "$sess_backup"
fi

cat <<'EOF'

Done. Start Zen and open https://outlook.office.com/mail/

Outlook site data is gone; AAD/Stanford/Duo cookies were kept when possible.
You may still get Duo once. After mail loads, open a second normal tab to the
same URL — that second cold entry is the real regression check.

If the sign-out returns, quit Zen and run: zen-sso-fix --deep
EOF
