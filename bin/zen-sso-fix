#!/bin/bash
#
# Recovers Outlook Web when it signs you out a second after a successful
# Stanford login ("You're signed out of your account. It's a good idea to close
# all browser windows.").
#
# What is established, from the redirect chain in places.sqlite: authentication
# succeeds, OWA loads, and then the page itself navigates to AAD's logout
# endpoint carrying a logout_hint for the account and an MSAL state blob marking
# a deliberate logoutRedirect(). So the token is valid and OWA discards it.
# Failures correlate with Outlook cookies left over from an earlier session;
# deleting just those and letting OWA mint fresh ones has cleared it, without
# re-authenticating.
#
# What is NOT established: why OWA rejects the session. The suspect is the
# HttpOnly OIDC cookie carrying stale session state, but that is unproven and
# would need MOZ_LOG capture of the live failure to confirm. This is a
# recurring, widely reported Firefox/OWA problem with no confirmed root cause
# upstream, so treat this script as a recovery, not a cure.
#
# Deliberately narrow. It touches Outlook cookies only, so login.microsoftonline
# and Stanford SSO survive and recovery costs a page reload rather than a fresh
# Duo push. Earlier versions of this script also wiped localStorage, IndexedDB,
# service workers and the HTTP cache for every Microsoft domain; that was based
# on a diagnosis that later proved wrong, and it forced a full SAML re-login for
# no benefit. Use --deep if the narrow reset ever stops working.
#
# Zen must be fully closed, since it holds a write lock on cookies.sqlite.
#
# Usage: zen-sso-fix [--deep]

set -euo pipefail

deep=0
case "${1:-}" in
  --deep) deep=1 ;;
  '') ;;
  *) printf 'Usage: %s [--deep]\n' "${0##*/}" >&2; exit 2 ;;
esac

# The hosts OWA itself serves from. Neither login.microsoftonline.com nor
# anything under stanford.edu appears here, so the SSO session is preserved.
outlook_hosts=(
  outlook.office.com
  outlook.office365.com
  outlook.cloud.microsoft
)

# --deep only. Widened to every Microsoft origin, which does cost a re-login.
deep_domains=(
  microsoftonline.com
  cloud.microsoft
  office.com
  office365.com
  outlook.com
  live.com
  windows.net
)

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
cache_home="${XDG_CACHE_HOME:-$HOME/.cache}"
zen_home="$config_home/zen"

if [[ ! -f $zen_home/profiles.ini ]]; then
  printf 'No Zen profiles.ini under %s. Launch Zen once first.\n' "$zen_home" >&2
  exit 1
fi

if pgrep -x zen-bin >/dev/null || pgrep -f '/zen/zen$' >/dev/null; then
  printf 'Zen is still running. Quit it completely, then re-run.\n' >&2
  exit 1
fi

# profiles.ini names the profile directory with a random prefix, so resolve it
# rather than hardcoding. An [InstallHASH] section's Default= wins over a
# [ProfileN] Default=1, matching Zen's own precedence.
profile_rel=$(python3 - "$zen_home/profiles.ini" <<'PY'
import configparser, sys
cp = configparser.ConfigParser()
cp.read(sys.argv[1])
install = next((cp[s]["Default"] for s in cp.sections()
                if s.startswith("Install") and cp[s].get("Default")), None)
if install:
    print(install)
    raise SystemExit
for s in cp.sections():
    if s.startswith("Profile") and cp[s].get("Default") == "1":
        print(cp[s]["Path"])
        raise SystemExit
for s in cp.sections():
    if s.startswith("Profile") and cp[s].get("Path"):
        print(cp[s]["Path"])
        raise SystemExit
raise SystemExit("no profile found in profiles.ini")
PY
)

profile="$zen_home/$profile_rel"
[[ -d $profile ]] || { printf 'Resolved profile %s does not exist.\n' "$profile" >&2; exit 1; }
printf 'Profile: %s\n\n' "$profile"

backup="$profile/.sso-fix-backup.$(date +%Y%m%d%H%M%S)"
mkdir -p "$backup"
cp -- "$profile/cookies.sqlite" "$backup/cookies.sqlite"
if (( deep )); then
  for f in storage.sqlite serviceworker.txt; do
    if [[ -f $profile/$f ]]; then cp -- "$profile/$f" "$backup/$f"; fi
  done
fi
printf 'Backed up to %s\n\n' "$backup"

before=$(sqlite3 "$profile/cookies.sqlite" "SELECT count(*) FROM moz_cookies;")

if (( deep )); then
  # Exact match plus any subdomain, and partitioned copies these sites left
  # inside other sites.
  pred=""
  for d in "${deep_domains[@]}"; do
    pred+="${pred:+ OR }host = '$d' OR host LIKE '%.$d' OR originAttributes LIKE '%$d%'"
  done
else
  pred=""
  for h in "${outlook_hosts[@]}"; do
    pred+="${pred:+ OR }host = '$h'"
  done
fi

sqlite3 "$profile/cookies.sqlite" "DELETE FROM moz_cookies WHERE $pred;"
after=$(sqlite3 "$profile/cookies.sqlite" "SELECT count(*) FROM moz_cookies;")
printf 'Cookies removed: %s\n' "$(( before - after ))"

printf 'SSO cookies kept: %s AAD, %s Stanford, %s Duo\n' \
  "$(sqlite3 "$profile/cookies.sqlite" "SELECT count(*) FROM moz_cookies WHERE host LIKE '%microsoftonline.com';")" \
  "$(sqlite3 "$profile/cookies.sqlite" "SELECT count(*) FROM moz_cookies WHERE host LIKE '%stanford.edu';")" \
  "$(sqlite3 "$profile/cookies.sqlite" "SELECT count(*) FROM moz_cookies WHERE host LIKE '%duosecurity.com';")"

if (( deep )); then
  removed=0
  shopt -s nullglob
  for d in "${deep_domains[@]}"; do
    for dir in "$profile"/storage/default/*"$d"*; do
      [[ -d $dir ]] || continue
      rm -rf -- "$dir"
      removed=$(( removed + 1 ))
    done
  done
  shopt -u nullglob
  printf 'Storage origins cleared: %s\n' "$removed"

  # Keep the quota manager index from pointing at directories that are gone.
  origin_pred=""
  for d in "${deep_domains[@]}"; do
    origin_pred+="${origin_pred:+ OR }origin LIKE '%$d'"
  done
  sqlite3 "$profile/storage.sqlite" "DELETE FROM origin WHERE $origin_pred;" 2>/dev/null || true

  # Positional flat format, not safe to edit line by line, so drop it whole;
  # every site re-registers its worker on the next visit.
  rm -f -- "$profile/serviceworker.txt"
  printf 'Service worker registrations reset\n'

  cache_dir="$cache_home/zen/$profile_rel/cache2"
  if [[ -d $cache_dir ]]; then
    rm -rf -- "$cache_dir"
    printf 'HTTP cache cleared\n'
  fi
fi

cat <<'EOF'

Done. Start Zen and open https://outlook.office.com/mail/

The narrow reset keeps your Microsoft and Stanford sessions, so this should
drop you straight back into your mail without a password or Duo prompt. If it
instead sends you through a full login, that is expected only with --deep.

If the sign-out returns, quit Zen and run this again. If the narrow reset stops
working, try: zen-sso-fix --deep
EOF
