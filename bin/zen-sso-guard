#!/bin/bash
# Read-only Outlook SSO diagnostics. Never deletes or rewrites profile state.
# localStorage key counts do not prove whether MSAL has a usable session.
# Explicit permission-only repair (Zen closed): zen-sso-fix --repair-etp
set -euo pipefail

case "${1:-}" in
  --check|-n|'') ;;
  --help|-h)
    printf 'Usage: zen-sso-guard [--check]\n\nAlways report-only, including while Zen is running.\n'
    exit 0 ;;
  *) printf 'Usage: %s [--check]\n' "${0##*/}" >&2; exit 2 ;;
esac

python3 - "${XDG_CONFIG_HOME:-$HOME/.config}/zen" <<'PY'
import atexit
import configparser
import json
import re
import shutil
import sqlite3
import sys
import tempfile
from contextlib import ExitStack, closing
from pathlib import Path

zen_home = Path(sys.argv[1])
cp = configparser.ConfigParser()
if not cp.read(zen_home / "profiles.ini"):
    raise SystemExit(f"No Zen profiles.ini under {zen_home}.")
section = next((s for s in cp.sections() if s.startswith("Install") and cp[s].get("Default")), None)
if section:
    profile = Path(cp[section]["Default"])
else:
    section = next((s for s in cp.sections() if s.startswith("Profile") and cp[s].get("Default") == "1"), None)
    section = section or next((s for s in cp.sections() if s.startswith("Profile") and cp[s].get("Path")), None)
    if not section:
        raise SystemExit("No profile found in profiles.ini")
    profile = Path(cp[section]["Path"])
profile = zen_home / profile
if not profile.is_dir():
    raise SystemExit(f"Profile does not exist: {profile}")
print(f"Profile: {profile}\n")

# Private, unique snapshots include WAL data and are removed even on failure.
# Opening profile databases directly can fail while Firefox holds exclusive locks.
stack = ExitStack()
atexit.register(stack.close)
scratch = Path(stack.enter_context(tempfile.TemporaryDirectory(prefix="zen-sso-check-")))
errors = []
def snapshot(src):
    dst = scratch / f"db-{len(list(scratch.iterdir()))}.sqlite"
    shutil.copy2(src, dst)
    wal = Path(str(src) + "-wal")
    if wal.exists():
        shutil.copy2(wal, Path(str(dst) + "-wal"))
    return stack.enter_context(closing(sqlite3.connect(dst)))

storage = profile / "storage/default"
print("=== Outlook localStorage (metadata only, not an authentication verdict) ===")
for host in ["outlook.office.com", "outlook.office365.com", "outlook.cloud.microsoft", "sdf.outlook.cloud.microsoft"]:
    db = storage / f"https+++{host}/ls/data.sqlite"
    if not db.exists():
        print(f"  {host}: no localStorage")
        continue
    try:
        keys = [str(row[0]) for row in snapshot(db).execute("SELECT key FROM data")]
        print(f"  {host}: keys={len(keys)}, msal-prefixed={sum(k.startswith('msal') for k in keys)}, isauthed-key={'olk-isauthed' in keys}")
    except (OSError, sqlite3.Error) as exc:
        errors.append(f"{host}: {type(exc).__name__}")
print("  Tokens may live in sessionStorage or memory; no site data is deleted.")

print("\n=== Cookie / ETP / storage-access permissions ===")
bad_etp = []
perms = profile / "permissions.sqlite"
if perms.exists():
    try:
        rows = snapshot(perms).execute("SELECT origin, type, permission, expireType FROM moz_perms ORDER BY origin, type")
        relevant = ("outlook", "cloud.microsoft", "office.com", "login.microsoftonline.com", "login.stanford.edu", "idp.stanford.edu")
        for origin, typ, permission, expiry in rows:
            if not any(host in origin for host in relevant):
                continue
            if typ not in ("cookie", "trackingprotection", "storageAccessAPI") and not typ.startswith("3rdPartyStorage^"):
                continue
            if typ == "trackingprotection" and permission != 1:
                bad_etp.append(origin)
            print(f"  {origin} | {typ} | permission={permission} | expireType={expiry}")
    except (OSError, sqlite3.Error) as exc:
        errors.append(f"permissions: {type(exc).__name__}")
else:
    print("  No permissions database. Use the browser shield to configure site exceptions.")

print("\n=== Dark Reader exclusions ===")
sync = profile / "storage-sync-v2.sqlite"
if sync.exists():
    try:
        row = snapshot(sync).execute("SELECT data FROM storage_sync_data WHERE ext_id='addon@darkreader.org'").fetchone()
        if row:
            excluded = set(json.loads(row[0]).get("disabledFor") or [])
            need = {"outlook.office.com", "outlook.cloud.microsoft", "login.microsoftonline.com", "login.stanford.edu", "duosecurity.com"}
            print(f"  Relevant exclusions missing: {sorted(need - excluded) or 'none'}")
        else:
            print("  No Dark Reader settings found (extension may not be installed).")
    except (OSError, sqlite3.Error, ValueError, TypeError) as exc:
        errors.append(f"Dark Reader: {type(exc).__name__}")
else:
    print("  No extension sync database (not an authentication error).")

print("\n=== uBlock filter metadata ===")
prefs = profile / "prefs.js"
try:
    match = re.search(r'user_pref\("extensions\.webextensions\.uuids", (".*")\);', prefs.read_text()) if prefs.exists() else None
    uuid = json.loads(json.loads(match.group(1))).get("uBlock0@raymondhill.net") if match else None
    found = False
    if uuid:
        for base in [storage / f"moz-extension+++{uuid}^userContextId=4294967295", storage / f"moz-extension+++{uuid}"]:
            for db in base.glob("idb/*.sqlite"):
                rows = snapshot(db).execute("SELECT data FROM object_data")
                found = found or any(isinstance(row[0], bytes) and b"@@||login.microsoftonline" in row[0] for row in rows)
                blobs = Path(str(db) + ".files")
                if blobs.is_dir():
                    found = found or any(p.is_file() and b"@@||login.microsoftonline" in p.read_bytes() for p in blobs.iterdir())
        print(f"  Microsoft exception text found: {found} (not proof of effective filtering).")
    else:
        print("  uBlock not detected (not an authentication error).")
except (OSError, sqlite3.Error, ValueError, TypeError) as exc:
    errors.append(f"uBlock: {type(exc).__name__}")

print("\n=== summary ===")
print(f"  Incorrect ETP exceptions: {bad_etp or 'none detected'}")
print(f"  Diagnostic read errors: {errors or 'none'}")
print("  Read-only check complete. No profile state changed.")
if bad_etp:
    print("  After closing Zen: zen-sso-fix --repair-etp (no cookies or sessions cleared).")
sys.exit(1 if bad_etp or errors else 0)
PY
