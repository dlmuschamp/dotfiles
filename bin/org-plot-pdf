#!/usr/bin/env python3
"""Explicitly run Org MATLAB plots, then invoke the sibling org-pdf.

Example: #+begin_src matlab :plot yes
Literal :plot yes is authoritative, even with :eval never or :eval no.
Selected bodies run in a shared script workspace, in document order.
No Org properties or inherited headers are consulted. Ordinary blocks never run.
MATLAB code is arbitrary code running with your permissions, NOT a sandbox.
Outputs are staged and individually atomically replaced only after all plots pass.
Code can itself modify files, so staging cannot protect against malicious bodies.
"""
import argparse
import os
from pathlib import Path
import re
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile

MARKER = re.compile(r'^\s*#\+(begin|end)_([\w-]+)(?:\s+(.*))?\s*$', re.I)


def output_path(root, name):
    path = Path(name)
    if (not name or path.is_absolute() or '..' in path.parts
            or '\\' in name or any(ord(c) < 32 for c in name)
            or path.suffix not in ('.png', '.svg')):
        raise ValueError('unsafe :file path: ' + name)
    destination = root / path
    if not destination.resolve().is_relative_to(root.resolve()):
        raise ValueError(':file must remain inside document root: ' + name)
    if destination.exists() and not destination.is_file():
        raise ValueError(':file is not a regular file: ' + name)
    return destination


def headers(text):
    try:
        tokens = shlex.split(text, comments=False)
    except ValueError as error:
        raise ValueError('malformed source header: ' + str(error)) from error
    if not tokens or tokens[0].startswith(':'):
        raise ValueError('source header requires a language')
    result = {}
    index = 1
    while index < len(tokens):
        key = tokens[index]
        if not key.startswith(':') or len(key) == 1:
            raise ValueError('malformed source header near ' + key)
        index += 1
        values = []
        while index < len(tokens) and not tokens[index].startswith(':'):
            values.append(tokens[index])
            index += 1
        if key in result and key in (':plot', ':file', ':eval'):
            raise ValueError('duplicate header ' + key)
        result[key] = values
    return tokens[0], result


def parse_blocks(text, root, stem='document'):
    """Return selected blocks plus exact header and end-marker locations."""
    stack = []
    selected = []
    seen = set()
    body = []
    destination = None
    ordinal = 0
    safe_stem = re.sub(r'[^A-Za-z0-9_-]+', '-', stem).strip('-') or 'document'
    for number, line in enumerate(text.splitlines(keepends=True)):
        marker = MARKER.match(line)
        # Source bodies are opaque, even when containing Org-looking strings.
        if stack and stack[-1] == 'src':
            if marker and marker[1].lower() == 'end' and marker[2].lower() == 'src':
                stack.pop()
                if destination is not None:
                    selected.append(dict(body=''.join(body), destination=destination,
                                         name=files[0], missing=missing, start=start, end=number))
                destination = None
                body = []
            elif destination is not None:
                body.append(line)
            continue
        if not marker:
            continue
        action, kind, rest = marker.groups()
        action, kind = action.lower(), kind.lower()
        if action == 'end':
            if not stack or stack.pop() != kind:
                raise ValueError('unmatched block ending: ' + kind)
            continue
        if kind == 'src' and not stack:
            language, args = headers(rest or '')
            if language.lower() == 'matlab':
                ordinal += 1
            if args.get(':plot') == ['yes']:
                if language.lower() != 'matlab':
                    raise ValueError(':plot yes requires language matlab')
                missing = ':file' not in args
                start = number
                files = args.get(':file', ['figures/%s-plot-%d.png' % (safe_stem, ordinal)])
                if len(files) != 1:
                    raise ValueError(':plot yes requires one :file')
                destination = output_path(root, files[0])
                identity = destination.resolve()
                if identity in seen:
                    raise ValueError('duplicate output: ' + files[0])
                seen.add(identity)
        stack.append(kind)
    if stack:
        raise ValueError('unclosed block: ' + stack[-1])
    if not selected:
        raise ValueError('no top-level MATLAB blocks with exact :plot yes; change :plot never to :plot yes')
    return selected


def parse(text, root):
    """Compatibility API returning (body, destination) pairs."""
    return [(b['body'], b['destination']) for b in parse_blocks(text, root)]


def materialize(text, blocks):
    lines = text.splitlines(keepends=True)
    existing = set()
    stack = []
    for line in lines:
        marker = MARKER.match(line)
        if stack and stack[-1] == 'src':
            if marker and marker[1].lower() == 'end' and marker[2].lower() == 'src':
                stack.pop()
            continue
        if marker:
            action, kind, _ = marker.groups()
            if action.lower() == 'begin':
                stack.append(kind.lower())
            elif stack:
                stack.pop()
            continue
        if not stack:
            link = re.fullmatch(r'\s*\[\[file:([^]\r\n]+)\](?:\[[^\r\n]*\])?\]\s*', line)
            if link:
                existing.add(link[1])
    for block in reversed(blocks):
        if block['missing']:
            index = block['start']
            line = lines[index]
            ending = '\r\n' if line.endswith('\r\n') else '\n' if line.endswith('\n') else ''
            content = line[:-len(ending)] if ending else line
            lines[index] = content + ' :file ' + block['name'] + ending
        if not any(Path(name) == Path(block['name']) for name in existing):
            index = block['end']
            ending = '\r\n' if lines[index].endswith('\r\n') else '\n'
            if not lines[index].endswith('\n'):
                lines[index] += ending
            lines[index] += '[[file:' + block['name'] + ']]' + ending
            existing.add(block['name'])
    return ''.join(lines)


def quote(value):
    return "'" + str(value).replace("'", "''") + "'"


def run_matlab(command, cwd, timeout):
    # Descendant ServiceHost processes may outlive MATLAB. Never give them the
    # caller's pipes, otherwise an outer capture can wait forever for EOF.
    with tempfile.TemporaryFile() as log:
        try:
            _run_matlab(command, cwd, timeout, log)
        finally:
            log.seek(0)
            while chunk := log.read(65536):
                sys.stdout.write(chunk.decode(errors='replace'))
            sys.stdout.flush()


def _run_matlab(command, cwd, timeout, log):
    process = subprocess.Popen(command, cwd=cwd, start_new_session=True,
                               stdout=log, stderr=log)
    try:
        status = process.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except (ProcessLookupError, PermissionError, AttributeError):
            process.kill()
        process.wait()
        raise ValueError('MATLAB timed out after %s seconds' % timeout)
    if status:
        raise ValueError('MATLAB failed with exit status %s' % status)


def export(document, matlab='matlab', timeout=120, open_pdf=False):
    document = Path(document).resolve(strict=True)
    root = document.parent
    original = document.read_bytes()
    original_stat = document.stat()
    text = original.decode('utf-8')
    metadata = parse_blocks(text, root, document.stem)
    blocks = [(b['body'], b['destination']) for b in metadata]
    updated = materialize(text, metadata).encode('utf-8')
    executable = shutil.which(matlab)
    if executable is None:
        raise ValueError('MATLAB executable not found: %s (use --matlab PATH)' % matlab)
    with tempfile.TemporaryDirectory(prefix='.org-plot-', dir=root) as directory, \
            tempfile.NamedTemporaryFile(prefix='org_plot_', suffix='.m', dir=root) as script_file:
        stage = Path(directory)
        outputs = [stage / ('plot-%d%s' % (i, dest.suffix))
                   for i, (_, dest) in enumerate(blocks)]
        script = Path(script_file.name)
        calls = ["set(groot, 'defaultFigureVisible', 'off');"]
        for i, ((body, _), output) in enumerate(zip(blocks, outputs)):
            calls.append("close all force;\nset(groot, 'defaultFigureVisible', 'off');\n%s\norg_plot_figure = get(groot, 'CurrentFigure');\nif isempty(org_plot_figure)\nerror('org_plot:noFigure', 'Plot block did not create a figure');\nend\nexportgraphics(org_plot_figure, %s);\n" % (body, quote(output)))
        script.write_text('\n'.join(calls))
        run_matlab([executable, '-batch', 'run(%s)' % quote(script)], root, timeout)
        for output in outputs:
            if output.is_symlink() or not output.is_file() or output.stat().st_size == 0:
                raise ValueError('MATLAB did not generate expected plot: ' + output.name)
        for _, destination in blocks:
            output_path(root, str(destination.relative_to(root)))
        current_stat = document.stat()
        signature = lambda stat: (stat.st_dev, stat.st_ino, stat.st_size,
                                  stat.st_mtime_ns, stat.st_ctime_ns)
        if (document.read_bytes() != original or
                signature(current_stat) != signature(original_stat)):
            raise ValueError('document changed during MATLAB execution; refusing to publish outputs')
        for (_, destination), output in zip(blocks, outputs):
            destination.parent.mkdir(parents=True, exist_ok=True)
            os.replace(output, destination)
        if updated != original:
            temporary = None
            try:
                with tempfile.NamedTemporaryFile(prefix='.org-plot-document-', dir=root,
                                                 delete=False) as org_file:
                    temporary = Path(org_file.name)
                    os.fchmod(org_file.fileno(), original_stat.st_mode & 0o7777)
                    org_file.write(updated)
                    org_file.flush()
                    os.fsync(org_file.fileno())
                os.replace(temporary, document)
            finally:
                if temporary is not None:
                    temporary.unlink(missing_ok=True)
    command = [str(Path(__file__).resolve().with_name('org-pdf')), str(document)]
    if open_pdf:
        command.append('--open')
    subprocess.run(command, cwd=root, check=True)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('file', type=Path)
    parser.add_argument('--open', action='store_true')
    parser.add_argument('--matlab', default='matlab')
    parser.add_argument('--timeout', type=float, default=120)
    args = parser.parse_args(argv)
    try:
        if not 0 < args.timeout < float('inf'):
            raise ValueError('--timeout must be positive and finite')
        export(args.file, args.matlab, args.timeout, args.open)
    except (ValueError, OSError, subprocess.SubprocessError) as error:
        print('org-plot-pdf: ' + str(error), file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
