#!/bin/bash
#
# Cold-start wrapper for Zen Browser.
#
# Cold-start only: repair ETP allow-list values without clearing any site data,
# then run read-only diagnostics. Never mutate a running browser's profile.
#
# Desktop entry: ~/.local/share/applications/zen.desktop (from zen/zen.desktop)
# Real binary:   /opt/zen-browser-bin/zen-bin

set -euo pipefail

zen_real="${ZEN_BIN:-/opt/zen-browser-bin/zen-bin}"

if [[ ! -x $zen_real ]]; then
  printf 'Zen binary not found: %s\n' "$zen_real" >&2
  exit 1
fi

if ! pgrep -x zen-bin >/dev/null; then
  if command -v zen-sso-fix >/dev/null; then
    if ! zen-sso-fix --repair-etp; then
      printf 'ETP repair failed; launching Zen anyway. Retry with Zen closed: zen-sso-fix --repair-etp\n' >&2
    fi
  fi
  if command -v zen-sso-guard >/dev/null; then
    # Diagnostics must never block opening the browser.
    if ! zen-sso-guard --check; then
      printf 'SSO diagnostic warnings; launching Zen anyway. Run: zen-outlook --check\n' >&2
    fi
  fi
fi

exec "$zen_real" "$@"
