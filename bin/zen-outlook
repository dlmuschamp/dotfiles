#!/bin/bash
#
# Outlook launcher. Normal launches never clear browser state.
# The zen wrapper repairs ETP exceptions only before a cold start.
# Findings: ~/dotfiles/zen/outlook-sso-findings.txt
#
# Usage:
#   zen-outlook           open mail through the safe zen wrapper
#   zen-outlook --recover explicitly quit Zen, deep wipe, harden, reopen mail
#   zen-outlook --check   read-only diagnostics

set -euo pipefail

# Use a clean entry URL, never a restored OAuth code or logout URL.
url=https://outlook.cloud.microsoft/mail/
zen_bin=/opt/zen-browser-bin/zen-bin

zen_running() {
  pgrep -x zen-bin >/dev/null
}

quit_zen() {
  if zen_running; then
    printf 'Quitting Zen...\n'
    pkill -TERM -x zen-bin || true
    for _ in $(seq 1 30); do
      zen_running || break
      sleep 0.5
    done
    if zen_running; then
      printf 'Zen did not quit. Close it manually, then re-run.\n' >&2
      exit 1
    fi
  fi
}

open_normal() {
  if zen_running; then
    exec zen --new-tab "$url"
  fi
  exec zen "$url"
}

recover() {
  quit_zen
  # Destructive recovery is opt-in only. Never used by a normal launch.
  zen-sso-fix --deep
  zen-sso-harden
  exec "$zen_bin" "$url"
}

case "${1:-}" in
  --recover|-r) recover ;;
  --check|-n)
    zen-sso-guard --check
    ;;
  --help|-h)
    cat <<'EOF'
Usage: zen-outlook [--recover|--check]

  (no args)   Open mail through zen. Cold start repairs ETP exceptions only.
  --recover   Quit Zen, deep reset, harden, reopen mail. Clears sessions, costs Duo.
  --check     Read-only diagnostics. Does not classify localStorage as poisoned.
EOF
    exit 0
    ;;
  '')
    open_normal
    ;;
  *)
    printf 'Usage: %s [--recover|--check]\n' "${0##*/}" >&2
    exit 2
    ;;
esac
