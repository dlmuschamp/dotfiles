#!/bin/bash
#
# Permanent Outlook SSO hardening for Zen (not a private-window workaround).
#
# Evidence (2026-09-08 experiments): the "You're signed out / close all browser
# windows" loop is OWA calling AAD logoutRedirect() after Duo because MSAL never
# writes tokens on the Outlook origin. That post-auth failure was reproduced
# with extensions active under the prior extension storage, and cleared when
# extensions were disabled — while keeping AAD cookies. Brave never hit it
# (no uBlock; Dark Reader present but Chromium auth path differs).
#
# This script:
#   1. Pins Dark Reader disabledFor on Microsoft / Stanford / Duo hosts
#      (storage-sync; survives restarts).
#   2. Writes uBlock My filters exceptions into extension IndexedDB (the paste
#      step was never applied on this profile — confirmed 2026-09-10).
#   3. Merges the same exceptions into Zen distribution policies.json when
#      writable (survives profile resets; lost on Zen package upgrade until
#      re-run).
#
# Zen must be fully closed (same lock rules as zen-sso-fix).
#
# Usage: zen-sso-harden

set -euo pipefail

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
zen_home="$config_home/zen"
filters_file="$HOME/dotfiles/zen/ublock-outlook-exceptions.txt"

if pgrep -x zen-bin >/dev/null; then
  printf 'Zen is still running. Quit it completely, then re-run.\n' >&2
  exit 1
fi

if [[ ! -f $zen_home/profiles.ini ]]; then
  printf 'No Zen profiles.ini under %s.\n' "$zen_home" >&2
  exit 1
fi

if [[ ! -f $filters_file ]]; then
  printf 'Missing filter file: %s\n' "$filters_file" >&2
  exit 1
fi

profile_rel=$(python3 - "$zen_home/profiles.ini" <<'PY'
import configparser, sys
cp = configparser.ConfigParser()
cp.read(sys.argv[1])
install = next((cp[s]["Default"] for s in cp.sections()
                if s.startswith("Install") and cp[s].get("Default")), None)
if install:
    print(install); raise SystemExit
for s in cp.sections():
    if s.startswith("Profile") and cp[s].get("Default") == "1":
        print(cp[s]["Path"]); raise SystemExit
for s in cp.sections():
    if s.startswith("Profile") and cp[s].get("Path"):
        print(cp[s]["Path"]); raise SystemExit
raise SystemExit("no profile found")
PY
)

profile="$zen_home/$profile_rel"
sync_db="$profile/storage-sync-v2.sqlite"
[[ -f $sync_db ]] || { printf 'No storage-sync-v2.sqlite in %s (open Zen once with Dark Reader installed).\n' "$profile" >&2; exit 1; }

python3 - "$sync_db" <<'PY'
import json, sqlite3, sys
path = sys.argv[1]
sites = [
    "outlook.office.com",
    "outlook.office365.com",
    "outlook.cloud.microsoft",
    "outlook.live.com",
    "login.microsoftonline.com",
    "login.microsoft.com",
    "login.live.com",
    "login.windows.net",
    "office.com",
    "www.office.com",
    "cloud.microsoft",
    "m365.cloud.microsoft",
    "login.stanford.edu",
    "idp.stanford.edu",
    "duosecurity.com",
    "api-531b0865.duosecurity.com",
]
con = sqlite3.connect(path)
row = con.execute(
    "SELECT data FROM storage_sync_data WHERE ext_id='addon@darkreader.org'"
).fetchone()
if not row or not row[0]:
    raise SystemExit("Dark Reader not present in storage-sync; install/enable it once, then re-run.")
data = json.loads(row[0])
disabled = list(data.get("disabledFor") or [])
added = [s for s in sites if s not in disabled]
disabled.extend(added)
data["disabledFor"] = disabled
data["enabled"] = True
payload = json.dumps(data, separators=(",", ":"))
con.execute(
    "UPDATE storage_sync_data SET data=?, sync_change_counter=sync_change_counter+1 WHERE ext_id='addon@darkreader.org'",
    (payload,),
)
mirror = con.execute(
    "SELECT guid FROM storage_sync_mirror WHERE ext_id='addon@darkreader.org'"
).fetchone()
if mirror:
    con.execute("UPDATE storage_sync_mirror SET data=? WHERE guid=?", (payload, mirror[0]))
con.commit()
print(f"Dark Reader disabledFor: {len(disabled)} hosts ({len(added)} newly added)")
for s in sites:
    print(f"  - {s}")
PY

# Write uBlock userFilters into extension IndexedDB (Firefox structured clone string).
python3 - "$profile" "$filters_file" <<'PY'
import json, re, sqlite3, sys
from pathlib import Path

profile = Path(sys.argv[1])
filters_text = Path(sys.argv[2]).read_text()
# Keep comment lines; uBlock accepts ! comments in My filters.
filters_text = filters_text.replace("\r\n", "\n").strip() + "\n"

prefs = (profile / "prefs.js").read_text(errors="replace")
m = re.search(r'user_pref\("extensions\.webextensions\.uuids", "(.+)"\);', prefs)
if not m:
    raise SystemExit("Could not resolve uBlock UUID from prefs.js")
uuids = json.loads(m.group(1).encode("utf-8").decode("unicode_escape"))
uuid = uuids.get("uBlock0@raymondhill.net")
if not uuid:
    raise SystemExit("uBlock0@raymondhill.net not in extensions.webextensions.uuids")

def plus1_key(name: str) -> bytes:
    # uBlock stores IDB keys as ASCII '0' + each char code + 1
    return ("0" + "".join(chr(ord(c) + 1) for c in name)).encode("ascii")

def sc_string(s: str) -> bytes:
    # Reverse-engineered from uBlock's version string entry in this profile.
    b = s.encode("utf-8")
    n = len(b)
    header = bytes([
        0x18, 0x04, 0x03, 0x00, 0x01, 0x01,
        0x44, 0xf1, 0xff,
        n & 0xff, (n >> 8) & 0xff, (n >> 16) & 0xff, 0x80,
        0x04, 0x00, 0xff, 0xff,
    ])
    return header + b + b"\x00\x00"

key = plus1_key("userFilters")
payload = sc_string(filters_text)

candidates = [
    profile / "storage" / "default" / f"moz-extension+++{uuid}^userContextId=4294967295",
    profile / "storage" / "default" / f"moz-extension+++{uuid}",
]
wrote = 0
for base in candidates:
    if not base.is_dir():
        continue
    for db in base.glob("idb/*.sqlite"):
        con = sqlite3.connect(str(db))
        # Firefox IndexedDB triggers call update_refcount(old, new) when
        # object_data.file_ids is non-NULL (e.g. deleting selfie blobs). That
        # function is only registered inside Firefox — stub it so DELETE works
        # from stock sqlite3.
        def update_refcount(old_ids, new_ids):
            def parse(ids):
                if ids is None:
                    return []
                return [int(p) for p in str(ids).split(".") if p]

            for fid in parse(old_ids):
                con.execute(
                    "UPDATE file SET refcount = refcount - 1 WHERE id = ?", (fid,)
                )
            for fid in parse(new_ids):
                row = con.execute(
                    "SELECT refcount FROM file WHERE id = ?", (fid,)
                ).fetchone()
                if row:
                    con.execute(
                        "UPDATE file SET refcount = refcount + 1 WHERE id = ?",
                        (fid,),
                    )
                else:
                    con.execute(
                        "INSERT INTO file (id, refcount) VALUES (?, 1)", (fid,)
                    )

        con.create_function("update_refcount", 2, update_refcount)
        stores = {name: i for i, name in con.execute("SELECT id, name FROM object_store")}
        # Prefer the real settings store; skip pure cache DBs.
        store_id = None
        for name in ("storage-local-data", "uBlock0CacheStorage"):
            if name in stores:
                store_id = stores[name]
                if name == "storage-local-data":
                    break
        if store_id is None:
            con.close()
            continue
        con.execute(
            "DELETE FROM object_data WHERE object_store_id=? AND key=?",
            (store_id, key),
        )
        con.execute(
            """INSERT INTO object_data (object_store_id, key, index_data_values, file_ids, data)
               VALUES (?, ?, NULL, NULL, ?)""",
            (store_id, key, payload),
        )
        # Drop compiled net selfie so uBlock rebuilds filters on next start.
        for selfie_name in (
            "cache/selfie/staticNetFilteringEngine",
            "cache/selfie/staticExtFilteringEngine",
        ):
            sk = plus1_key(selfie_name)
            row = con.execute(
                "SELECT file_ids FROM object_data WHERE object_store_id=? AND key=?",
                (store_id, sk),
            ).fetchone()
            con.execute(
                "DELETE FROM object_data WHERE object_store_id=? AND key=?",
                (store_id, sk),
            )
            if row and row[0]:
                # file_ids looks like ".55" — best-effort unlink
                for fid in str(row[0]).split("."):
                    if not fid:
                        continue
                    fpath = Path(str(db) + ".files") / fid
                    if fpath.is_file():
                        fpath.unlink()
        con.commit()
        con.close()
        wrote += 1
        print(f"uBlock userFilters written → {db} (store_id={store_id})")

if not wrote:
    raise SystemExit(
        "uBlock IndexedDB not found; open Zen once with uBlock enabled, quit, re-run."
    )
print(f"uBlock My filters: {len(filters_text.splitlines())} lines")
PY

# Merge into Zen distribution policies when possible (optional; needs write access).
policies_path="/opt/zen-browser-bin/distribution/policies.json"
python3 - "$policies_path" "$filters_file" <<'PY' || true
import json, sys
from pathlib import Path
path = Path(sys.argv[1])
filters = Path(sys.argv[2]).read_text().replace("\r\n", "\n").strip() + "\n"
if not path.exists():
    print(f"Skip policies: {path} missing")
    raise SystemExit(0)
try:
    data = json.loads(path.read_text())
except Exception as e:
    print(f"Skip policies: parse error: {e}")
    raise SystemExit(0)
policies = data.setdefault("policies", {})
third = policies.setdefault("3rdparty", {}).setdefault("Extensions", {})
ub = third.setdefault("uBlock0@raymondhill.net", {})
admin = ub.setdefault("adminSettings", {})
admin["userFilters"] = filters
try:
    path.write_text(json.dumps(data, indent=2) + "\n")
    print(f"Zen policies updated: {path}")
except PermissionError:
    print(f"Skip policies: no write access to {path} (optional; IDB write is enough)")
PY

cat <<EOF

Done.

Dark Reader ignores Microsoft / Stanford / Duo auth hosts.
uBlock My filters now include:
  $filters_file

If the sign-out loop returns anyway:
  zen-sso-guard          # wipe half-auth cloud.microsoft + re-pin grants
  zen-outlook --recover  # full deep wipe (costs Duo)

See: $HOME/dotfiles/zen/outlook-sso-findings.txt
EOF
